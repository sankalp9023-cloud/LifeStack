{
  "name": "@lifestack/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "import:localstorage": "node scripts/import-localstorage.mjs",
    "prisma:generate": "prisma generate",
    "db:deploy": "node scripts/require-database-url.mjs && prisma migrate deploy",
    "db:status": "node scripts/require-database-url.mjs && prisma migrate status",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@types/node": "^24.0.0",
    "prisma": "^7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "effect": "^3.22.1"
  }
}
